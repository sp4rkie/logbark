#!/bin/bash

# Site-local settings (ignore/replace rules, EMAIL_DOMAIN override, PRIV_CMD)
# live in $0.cfg, which is deliberately not part of this repo -- copy
# mylogwatch.cfg.example next to this script and adjust it per host.
PRGBNAME="${0##*/}"
WAIT_TO_SEND=5              # time span collecting messages until flush
RUNDIR="${TMPDIR:-/tmp}"    # all runtime state lives here; nothing is ever
                            # written next to the script, so it can be
                            # installed read-only (e.g. /usr/local/sbin)
IGNORES=""                  # extra drop patterns from the cfg; blank lines
                            # are always dropped, cfg or not
PRIV_CMD=""                 # e.g. "sudo" or a custom wrapper, only used when not root
. $0.cfg 2> /dev/null       # optionally cfg ignores (no error if missing)

LOGBUFF="$RUNDIR/$PRGBNAME" # LOGBUFF is shared/appended by every invocation and drained by FLUSH;
LOGLOCK="$LOGBUFF.lock"     # LOGLOCK guards that access so a flush can never race an append (see below).
SCHEDLOCK="$LOGBUFF.lck"    # SCHEDLOCK debounces the flush, so a burst yields one mail

# redirected only after the cfg is read, so RUNDIR can steer it too
[ -t 0 ] || exec >> "$LOGBUFF.log" 2>&1

# join all args into the one line we test and buffer, so a caller that
# forgets to quote cannot silently lose everything after the first word
MSG="$*"

# Only IGNORES decides what gets dropped. AP_ETHERS is a label table, not an
# ignore list: folding it in here matched any line merely mentioning a known
# device and discarded it, which is exactly the line replace_known_AP() is
# meant to annotate.
#
# An empty alternative matches every line, so a cfg whose IGNORES carries the
# conventional trailing '|' would otherwise silently discard the whole log.
IGNORE_RE="$IGNORES"
while [[ "$IGNORE_RE" == *'||'* ]]; do IGNORE_RE="${IGNORE_RE//||/|}"; done
IGNORE_RE="${IGNORE_RE#|}"
IGNORE_RE="${IGNORE_RE%|}"

if ! [[ "$MSG" =~ ^FLUSH$ ]]; then

    # any match leads to an ignore; a blank line always does
    if [[ -z "$MSG" || ( -n "$IGNORE_RE" && "$MSG" =~ $IGNORE_RE ) ]]; then
        printf "ignored\n"
    else
        (
            exec 200> "$LOGLOCK"
            flock -x 200
            # '%s' -- never let a log line act as the printf format string
            printf '%s\n' "$MSG" >> "$LOGBUFF"
        )
        # Hold the lock for the debounce window only, and drop it before
        # flushing: a line arriving while sendmail is still running must be
        # able to schedule the next flush, or it sits in LOGBUFF unsent
        # until some unrelated later line happens to trigger one.
        (flock -n 9 || exit; sleep $WAIT_TO_SEND) 9> "$SCHEDLOCK" && $0 FLUSH &
    fi

else

# Hand the buffer off to a private, uniquely-named file under the same
# lock used for appends. This only needs to exclude appends for the
# instant the mv takes -- writers resume immediately into a fresh
# LOGBUFF while we take our time reading/mailing this batch below, so a
# slow sendmail can never stall log writers.
LOGBATCH="$LOGBUFF.$$"

# mktemp (0600, O_EXCL) rather than a predictable name next to the script:
# the script's directory is typically not writable by the invoking user, and
# a guessable path in a shared RUNDIR would be a symlink target
AWKPROG=$(mktemp "$RUNDIR/$PRGBNAME.XXXXXX.awk") || exit 1

cat > "$AWKPROG" << !

func ex(CMD, \
    line)
{
    CMD = CMD " 2>&1"
    while (CMD | getline line > 0); close(CMD); return line
}

#
# ATTENTION:
# rev_resolution only called after SM_NAME is initialized to setup MYHOST correctly
#
func rev_resolution(tocheck, \
    CNT, CMD, line, a, b)
{
    while (match(tocheck, "^(|.*[^0-9#])([0-9]+\\\.[0-9]+\\\.[0-9]+\\\.[0-9]+)(|[^0-9].*)$", a)) {
        CMD = MYHOST " " a[2]; CMD | getline line; close(CMD)
        split(line, b)
        line = b[2]
        if (!line || match(line, "NXDOMAIN")) {
            line = a[2]
        }
        tocheck = a[1] "#" line a[3]

        #
        # delimit maximum loop cnt for your safety
        #
        if (CNT++ > 10) {
            print "mylogwatch: EMERGENCY BREAK IN LOOP"
            break
        }
    }
    return tocheck
}

#
# ETHERS holds "label", "identifier" pairs split out of AP_ETHERS, so the
# label lives at the odd index just below its identifier. The "__END__"
# sentinel that terminates AP_ETHERS also terminates this walk.
#
func replace_known_AP(line, \
    i, a, label)
{
    for (i = 2; ETHERS[i] && ETHERS[i] != "__END__"; i += 2) {
        if (match(line, "^(.*)" ETHERS[i] "(.*)$", a)) {
            # padding in the cfg is only there to line the pairs up
            label = gensub("^ +| +\$", "", "g", ETHERS[i - 1])
            return a[1] "[ " label " ]" a[2]
        }
    }
    return line
}

BEGIN {
    system("rm -f \"$AWKPROG\"")
    PRGBNAME = "$PRGBNAME"

    # AP_ETHERS comes in via -v (not interpolated into this script) so that
    # quotes or backslashes in a cfg label cannot break the generated awk
    split(AP_ETHERS, ETHERS, "|")

    # LOGBATCH is provided by the calling script through shell interpolation
    # (it hands us a private, already rotated-off copy of the shared buffer
    # -- see the mv below).
    LOGBATCH="$LOGBATCH"

    # dont use 'cat /etc/hostname' here because of race wit rsync from roja copy!!!!
    HOSTNAME = "$(hostname -s)"
    MYHOST = "/usr/bin/getent hosts"

    # fiddle EMAIL DOMAIN
    # first set a reasonable default
    EMAIL_DOMAIN = "example.com"

    # then try to retrieve from nullmailer cfg (if any)
    getline EMAIL_DOMAIN_NM < "/etc/nullmailer/remotes"; close("/etc/nullmailer/remotes")

    # if there is a simple smart host use that
    if (match(EMAIL_DOMAIN_NM, "^([^ ]+)", a)) {
        EMAIL_DOMAIN = a[1]
    }

    # highest priority: an explicit per-host override from mylogwatch.cfg
    EMAIL_DOMAIN_OVERRIDE = "$EMAIL_DOMAIN"
    if (EMAIL_DOMAIN_OVERRIDE) {
        EMAIL_DOMAIN = EMAIL_DOMAIN_OVERRIDE
    }

    ADDR_FROM = HOSTNAME " <" PRGBNAME "." HOSTNAME "@" EMAIL_DOMAIN ">"
    ADDR_TO =   ADDR_FROM
    SMTP_FROM = ADDR_FROM
    if (match(SMTP_FROM, "([< ]|^)([^< ]+@[^> ]+)([> ]|$)", a)) {
        SMTP_FROM = a[2]
    }
    SENDMAIL = "/usr/sbin/sendmail -t -f " SMTP_FROM
    getline line < LOGBATCH
    if (line) {
        print "From: " ADDR_FROM                    | SENDMAIL
        print "To: " ADDR_TO                        | SENDMAIL
        line = rev_resolution(gensub("^( *|<[^>]*>)", "", "g", line))
        line = replace_known_AP(line)

        #
        #avoid uncomplete time stamps in subject line like this
        #[    0.001491] Calibrati...
        #and print BogoMIPS alone...
        #
        sline = gensub("^\\\[[0-9 .]+\\\] ", "", "g", line)
        sline = gensub("^.*[^0-9.]([0-9.]+ BogoMIPS).*$", "\\\1", "g", sline)

        print "Subject: " (sline ? sline : "empty") | SENDMAIL
        print ""                                    | SENDMAIL
        print line                                  | SENDMAIL
        while (getline line < LOGBATCH > 0) {
            line = rev_resolution(gensub("^( *|<[^>]*>)", "", "g", line))
            line = replace_known_AP(line)
            print line                              | SENDMAIL
        }
        close(SENDMAIL)
    } else {
        print "EMPTY"
    }
    close(LOGBATCH)
    ex("rm -f " LOGBATCH)
}
!

# must exec as root to open /etc/nullmailer/...
[ $(id -u) -eq 0 ] || PP="$PRIV_CMD"

(
    exec 200> "$LOGLOCK"
    flock -x 200
    [ -f "$LOGBUFF" ] && mv "$LOGBUFF" "$LOGBATCH"
)

exec $PP awk -v AP_ETHERS="$AP_ETHERS" -f "$AWKPROG"

fi
